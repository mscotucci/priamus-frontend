    "/api/identity/users": {
      "get": {
        "operationId": "ListUsers",
        "parameters": [
          {
            "description": "Filter by role. When null, all roles are included.",
            "in": "query",
            "name": "role",
            "schema": {
              "$ref": "#/components/schemas/UserRole"
            }
          },
          {
            "description": "Filter by status. When null, all statuses are included.",
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/UserStatus"
            }
          },
          {
            "description": "Case-insensitive substring match on string Username.Value.\r\nWhen null or whitespace, no username filter is applied.",
            "in": "query",
            "name": "usernameContains",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1-based page number. Optional on the wire; values below 1 are coerced to 1\r\non the setter. Read via int PagedRequest.EffectivePage to get the resolved value\r\n(defaulting to int PagedRequest.DefaultPage when null).",
            "in": "query",
            "name": "page",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "description": "Page size between 1 and int PagedRequest.MaxPageSize. Optional on the wire;\r\nnon-positive values are coerced to int PagedRequest.DefaultPageSize, values\r\ngreater than int PagedRequest.MaxPageSize are clamped to int PagedRequest.MaxPageSize.\r\nRead via int PagedRequest.EffectivePageSize to get the resolved value\r\n(defaulting to int PagedRequest.DefaultPageSize when null).",
            "in": "query",
            "name": "pageSize",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "description": "Name of the column to sort by. Optional; handlers fall back to a default\r\nsafe column when this is null or not in their whitelist.",
            "in": "query",
            "name": "sortColumn",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sort direction. Optional on the wire; readers should use\r\nbool PagedRequest.IsAscending which resolves null to\r\nSortDirection.Ascending.",
            "in": "query",
            "name": "sortDirection",
            "schema": {
              "$ref": "#/components/schemas/SortDirection"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfUserListItemDto"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
