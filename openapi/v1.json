{
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "description": "Request body for `POST /api/identity/users`.",
        "properties": {
          "password": {
            "type": "string"
          },
          "role": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "role"
        ],
        "type": "object"
      },
      "CreateUserResponse": {
        "description": "Response body for a successful `POST /api/identity/users` request.",
        "properties": {
          "id": {
            "description": "The newly created user's identifier.",
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The functional role assigned to the user."
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus",
            "description": "The initial lifecycle status (always UserStatus.Active on creation)."
          },
          "username": {
            "description": "The normalized username.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "status"
        ],
        "type": "object"
      },
      "GetCurrentUserResponse": {
        "description": "The signed-in user as the database knows it now.",
        "properties": {
          "driverId": {
            "description": "The linked Registry driver for a `Driver` user; null when unlinked or for any other role.",
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "id": {
            "description": "The user's identifier.",
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "The user's role, serialised by name."
          },
          "username": {
            "description": "The user's normalised user name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "driverId"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "description": "Request body for `POST /api/identity/auth/login`.",
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "description": "Response payload for a successful login.",
        "properties": {
          "accessToken": {
            "description": "Short-lived JWT access token.",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "description": "UTC expiry of the access token.",
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "description": "Opaque long-lived refresh token (base64url, 43 chars).",
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "description": "UTC expiry of the refresh token.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresAt",
          "refreshTokenExpiresAt"
        ],
        "type": "object"
      },
      "PagedResponseOfUserListItemDto": {
        "description": "Response envelope for a paginated query. Immutable record.",
        "properties": {
          "data": {
            "description": "The items returned in the current page.",
            "items": {
              "$ref": "#/components/schemas/UserListItemDto"
            },
            "type": "array"
          },
          "hasNextPage": {
            "description": "True when there is a page after this one.",
            "type": "boolean"
          },
          "hasPreviousPage": {
            "description": "True when there is a page before this one.",
            "type": "boolean"
          },
          "page": {
            "description": "1-based page number returned.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "pageSize": {
            "description": "Page size used to compute the result.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "totalCount": {
            "description": "Total number of items across all pages.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "totalPages": {
            "description": "Total number of pages, computed as `ceil(TotalCount / PageSize)`.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "data",
          "totalCount",
          "page",
          "pageSize"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "RefreshRequest": {
        "description": "Request body for `POST /api/identity/auth/refresh`.",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RefreshResponse": {
        "description": "Response payload for a successful token refresh.",
        "properties": {
          "accessToken": {
            "description": "New short-lived JWT access token.",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "description": "UTC expiry of the new access token.",
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "description": "New opaque refresh token (base64url, 43 chars). The old token is now invalid.",
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "description": "UTC expiry of the new refresh token.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresAt",
          "refreshTokenExpiresAt"
        ],
        "type": "object"
      },
      "RevokeRequest": {
        "description": "Request body for `POST /api/identity/auth/revoke` (self-service logout).",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "SortDirection": {
        "enum": [
          "Ascending",
          "Descending",
          null
        ]
      },
      "UserListItemDto": {
        "description": "A single item in the paginated list of users.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastModifiedAt": {
            "format": "date-time",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "status",
          "createdAt",
          "lastModifiedAt"
        ],
        "type": "object"
      },
      "UserRole": {
        "description": "Functional role assigned to a User. Drives both back-office\r\nauthorization policies and the strict driver/back-office data boundary\r\n(drivers must never see pricing — see `docs/context.md` §1).",
        "enum": [
          "Driver",
          "BackOffice",
          "Admin"
        ]
      },
      "UserStatus": {
        "description": "Lifecycle state of a User. A disabled user cannot log in and\r\ncannot change password; the back office enables/disables users via dedicated\r\ncommands (per RNF-02 revocation requirement).",
        "enum": [
          "Active",
          "Disabled"
        ]
      }
    }
  },
  "info": {
    "title": "Priamus.Trips.Host | v1",
